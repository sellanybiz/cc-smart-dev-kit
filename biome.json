{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!plugin/dist",
      "!plugin/portal-ui",
      "!plugin/workflows",
      "!plugin/skills/shadcn",
      "!plugin/skills/migrate-radix-to-base",
      "!plugin/skills/shadcncraft-generate-code",
      "!plugin/skills/shadcncraft-import-variables",
      "!plugin/skills/shadcncraft-import-app",
      "!plugin/skills/shadcncraft-import-block",
      "!plugin/skills/shadcncraft-import-component",
      "!portal/node_modules",
      "!portal/.next",
      "!portal/out",
      "!portal/src/components/ui",
      "!portal/src/styles"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
