{
  "name": "cc-smart-dev-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "\"$npm_execpath\" test",
    "build": "\"$npm_execpath\" scripts/build.ts",
    "build:check": "\"$npm_execpath\" scripts/build.ts --check",
    "build:portal": "\"$npm_execpath\" scripts/portal-export.ts",
    "check:portal": "\"$npm_execpath\" scripts/portal-export.ts --check",
    "check:neutral": "\"$npm_execpath\" scripts/check-neutral.ts",
    "check:duplicates": "\"$npm_execpath\" scripts/check-duplicates.ts",
    "check:docs": "\"$npm_execpath\" scripts/check-docs.ts",
    "check:core-lines": "\"$npm_execpath\" scripts/check-core-lines.ts",
    "check:context-budget": "\"$npm_execpath\" scripts/check-context-budget.ts",
    "evals": "\"$npm_execpath\" evals/run.ts",
    "check": "\"$npm_execpath\" run typecheck && \"$npm_execpath\" run lint && \"$npm_execpath\" run check:neutral && \"$npm_execpath\" run check:duplicates && \"$npm_execpath\" run check:docs && \"$npm_execpath\" run check:core-lines && \"$npm_execpath\" run check:context-budget && \"$npm_execpath\" run test && \"$npm_execpath\" run build:check"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
