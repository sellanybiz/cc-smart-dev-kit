{
  "name": "anymodel",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "\"$npm_execpath\" test",
    "build": "\"$npm_execpath\" scripts/build.ts",
    "build:check": "\"$npm_execpath\" scripts/build.ts --check",
    "check:neutral": "\"$npm_execpath\" scripts/check-neutral.ts",
    "check": "\"$npm_execpath\" run typecheck && \"$npm_execpath\" run lint && \"$npm_execpath\" run check:neutral && \"$npm_execpath\" run test && \"$npm_execpath\" run build:check"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
