{
  "name": "anymodel",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "build:check": "bun scripts/build.ts --check",
    "check:neutral": "bun scripts/check-neutral.ts",
    "check:duplicates": "bun scripts/check-duplicates.ts",
    "check": "bun run typecheck && bun run lint && bun run check:neutral && bun run check:duplicates && bun run test && bun run build:check"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
