{
  "requires": ">=5.2",
  "worktrees": {
    "base": "main",
    "guardMainFolder": true,
    "bases": {
      "hotfix/": "main",
      "release/": "main"
    }
  },
  "protectedBranches": ["main"],
  "jobs": {
    "kinds": {
      "check": {
        "match": [{ "script": "check" }],
        "about": "The repo's full check: typecheck, lint, the doc checks, the tests and the build check."
      },
      "bundle": {
        "match": [{ "script": "build" }, { "script": "build:check" }],
        "about": "The plugin's bundle build, and its staleness check."
      }
    }
  },
  "sessionNames": false,
  "workflow": {
    "reviewBeforePush": true,
    "autoMerge": false,
    "crew": {
      "enabled": true
    },
    "plans": {
      "mergeFiles": [
        "plugin/.claude-plugin/plugin.json",
        "install.sh",
        "install.ps1",
        "CHANGELOG.md",
        "plugin/dist/",
        "plugin/portal-ui/",
        "bun.lock"
      ]
    }
  }
}
