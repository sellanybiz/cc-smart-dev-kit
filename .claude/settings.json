{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run check)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run check:neutral)",
      "Bash(bun run build)",
      "Bash(bun run build:check)",
      "Bash(bun run test)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "Bash(claude plugin validate *)"
    ],
    "deny": ["Bash(npm *)", "Bash(npx *)"]
  }
}
