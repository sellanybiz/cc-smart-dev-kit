        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cc-smart-dev-kit-bun.sh\" --missing=quiet \"${CLAUDE_PLUGIN_ROOT}/dist/user-away.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
