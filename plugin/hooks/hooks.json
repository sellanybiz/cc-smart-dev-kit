{
  "description": "cc-smart-dev-kit: git, edit (Edit/Write/NotebookEdit), merge, deploy, agent and session-escape guards, a caller-named screenshot put in the browser's output folder, notes after a merge and at session start, one note to the person when the session itself runs on Claude Fable, one note to Claude of what each subagent tier runs, the review record a finished review agent writes, each subagent's cost on record, one reminder when a turn that changed files did not run the project's fast check, one block when the main session would stop while a phase of its plan is in progress and nothing runs, one block when a builder subagent hands back while its task still has open steps, session names, the person's availability (while they cannot answer, a question or a plan awaiting approval is denied with the step that parks it, and a guard's question and Claude Code's own permission prompt are denied with the call parked for them, with one note said per change, at the prompt or by one block at the stop of a session that has not heard it), the background update check. Each hook stays silent while the project wires its own for the same event.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cc-smart-dev-kit-bun.sh\" --missing=ask \"${CLAUDE_PLUGIN_ROOT}/dist/user-away.js\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cc-smart-dev-kit-bun.sh\" --missing=ask \"${CLAUDE_PLUGIN_ROOT}/dist/git-guard.js\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cc-smart-dev-kit-bun.sh\" --missing=ask \"${CLAUDE_PLUGIN_ROOT}/dist/merge-guard.js\"",
            "onFailure": "block",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cc-smart-dev-kit-bun.sh\" --missing=ask \"${CLAUDE_PLUGIN_ROOT}/dist/deploy-guard.js\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cc-smart-dev-kit-bun.sh\" --missing=ask \"${CLAUDE_PLUGIN_ROOT}/dist/main-folder-guard.js\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cc-smart-dev-kit-bun.sh\" --missing=ask \"${CLAUDE_PLUGIN_ROOT}/dist/job-route.js\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task|Workflow",
