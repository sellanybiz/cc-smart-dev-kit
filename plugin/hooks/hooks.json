{
  "description": "anymodel: git, edit, message and agent guards, desktop notifications, notes after a merge and at session start, session names, the usage-limit alert and the background update check. Each hook stays silent while the project wires its own for the same event.",
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=quiet", "${CLAUDE_PLUGIN_ROOT}/dist/stop-failure.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=ask", "${CLAUDE_PLUGIN_ROOT}/dist/git-guard.js"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=ask", "${CLAUDE_PLUGIN_ROOT}/dist/main-folder-guard.js"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=ask", "${CLAUDE_PLUGIN_ROOT}/dist/message-guard.js"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=ask", "${CLAUDE_PLUGIN_ROOT}/dist/job-route.js"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=ask", "${CLAUDE_PLUGIN_ROOT}/dist/agent-guard.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|worker_permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=quiet", "${CLAUDE_PLUGIN_ROOT}/dist/notify.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=quiet", "${CLAUDE_PLUGIN_ROOT}/dist/notify.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=quiet", "${CLAUDE_PLUGIN_ROOT}/dist/after-merge.js"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=quiet", "${CLAUDE_PLUGIN_ROOT}/dist/after-merge.js"],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=quiet", "${CLAUDE_PLUGIN_ROOT}/dist/worktree-leftovers.js"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=quiet", "${CLAUDE_PLUGIN_ROOT}/dist/session-name.js"],
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=quiet", "${CLAUDE_PLUGIN_ROOT}/dist/update-check.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/anymodel-bun",
            "args": ["--missing=quiet", "${CLAUDE_PLUGIN_ROOT}/dist/session-name.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
